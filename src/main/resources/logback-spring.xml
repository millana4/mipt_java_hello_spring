<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Имя приложения из spring.application.name в application.properties -->
    <springProperty scope="context" name="application" source="spring.application.name" defaultValue="hello-spring"/>

    <!-- Вывод в консоль -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

</configuration>